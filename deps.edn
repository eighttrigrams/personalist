{:paths ["src/clj" "resources"]
  :deps {org.clojure/clojure               {:mvn/version "1.12.5"}
        com.taoensso/telemere             {:mvn/version "1.2.1"}
        com.taoensso/telemere-slf4j       {:mvn/version "1.2.1"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        com.github.seancorfield/honeysql  {:mvn/version "2.7.1389"}
        org.xerial/sqlite-jdbc            {:mvn/version "3.53.2.0"}
        dev.weavejester/ragtime.next-jdbc {:mvn/version "0.12.1"}
        org.clojure/data.json             {:mvn/version "2.5.2"}
        aero/aero                         {:mvn/version "1.1.6"}
        ring/ring-core                    {:mvn/version "1.15.4"}
        ring/ring-json                    {:mvn/version "0.5.1"}
        info.sunng/ring-jetty9-adapter    {:mvn/version "0.39.4"}
        ring-cors/ring-cors               {:mvn/version "0.1.13"}
       ;;  cheshire/cheshire                 {:mvn/version "5.13.0"}
        compojure/compojure               {:mvn/version "1.7.2"}
        buddy/buddy                       {:mvn/version "2.0.0"}
        metosin/malli                     {:mvn/version "0.20.0"}
        fmnoise/flow                      {:mvn/version "4.3.0"}
        nrepl/nrepl                       {:mvn/version "1.7.0"}
        ;; Line-level provenance — who wrote which lines of an identity's text,
        ;; given its version history. A sibling checkout by :local/root like every
        ;; other cross-app dependency in this suite; cookbook and rhizome name it
        ;; exactly this way. It resolves relative to *this file*, so the checkout
        ;; has to sit beside personalist's — in the box that is /workspace/us-vs-them,
        ;; and in the umbrella build /opt/us-vs-them, which plurama/Dockerfile
        ;; already copies for cookbook's sake. A clone without the sibling fails on
        ;; the first clj invocation rather than at the point of use.
        eighttrigrams/us-vs-them          {:local/root "../us-vs-them"}
        }
 :aliases {:run {:exec-fn et.pe.server/-main}
           ;; Tests are quiet at :info. Each one builds its own in-memory database,
           ;; and each of those logs its connection plus its six migrations — some
           ;; hundreds of lines per run, which is what `make deploy` shows you
           ;; instead of the result. Telemere reads this property itself, so no
           ;; namespace has to know that it is being run by a test.
           :test {:jvm-opts ["-Dtaoensso.telemere.rt-min-level=:warn"]
                  :extra-paths ["test/clj"]
                  :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                                      :git/sha "dfb30dd"}}
                  :main-opts   ["-m" "cognitect.test-runner"]
                  :exec-fn     cognitect.test-runner.api/test}
           :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd38dc39cb1880bd990d85718d4a61e194d"}}
                   :ns-default build}}}