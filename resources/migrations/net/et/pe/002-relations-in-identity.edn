{:id "002-relations-in-identity"
 :up ["ALTER TABLE identities ADD COLUMN relations TEXT"
      ;; Reconstruct, for every identity version, the set of relations that were
      ;; active at that version's valid_from (last event per relation_id was 'add'),
      ;; and store it as a JSON array of {target, description} maps. Correlated
      ;; scalar subquery (SQLite has no LATERAL, so no FROM-clause correlation).
      "UPDATE identities SET relations = COALESCE((
         SELECT json_group_array(json_object('target', r.target_id, 'description', null))
         FROM relations r
         WHERE r.persona_id = identities.persona_id
           AND r.source_id = identities.identity_id
           AND r.valid_from <= identities.valid_from
           AND r.event_type = 'add'
           AND r.id = (SELECT r2.id
                         FROM relations r2
                        WHERE r2.relation_id = r.relation_id
                          AND r2.valid_from <= identities.valid_from
                        ORDER BY r2.valid_from DESC, r2.id DESC
                        LIMIT 1)
       ), '[]')"
      "UPDATE identities SET relations = '[]' WHERE relations IS NULL"
      "DROP INDEX IF EXISTS idx_relations_lookup"
      "DROP TABLE IF EXISTS relations"]
 :down ["CREATE TABLE IF NOT EXISTS relations (
           id INTEGER PRIMARY KEY AUTOINCREMENT,
           relation_id TEXT NOT NULL,
           persona_id TEXT NOT NULL,
           source_id TEXT NOT NULL,
           target_id TEXT NOT NULL,
           event_type TEXT NOT NULL,
           valid_from INTEGER NOT NULL
         )"
        "CREATE INDEX IF NOT EXISTS idx_relations_lookup ON relations(persona_id, source_id, valid_from)"]
 :transactions false}
